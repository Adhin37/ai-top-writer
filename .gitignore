# The books belong to whoever ran the tool; the repo ships the engine.
novels/*
!novels/README.md
!novels/_template/

# Beta-reader exports and experiment arms: generated, and full of prose.
reading/
bench/

# Genre studies (tools/study.py): published books' chapters, saved by the user, and notes quoting them.
research/

# The test-run marker arms tools/guard.py for the main session.
.test-run

# Session handoffs and the usage reading: one machine's working state, full of agent prompts.
docs/sessions/

__pycache__/
*.pyc
.venv

# One machine's preferences and secrets: Claude Code's local overrides, env files, editors, OS.
CLAUDE.local.md
.claude/*.local.*
.env
.env.*
.vscode/
.idea/
.DS_Store
*.log
